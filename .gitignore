# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Build output
dist/
build/
.next/
.vite/
coverage/

# Environment and secrets
.env
.env.*
!.env.example

# Downloaded data and caches (large files stay out of git)
cache/
data/cache/
