# Claude Code. Ignore everything under any .claude/ by default.
# Track only shared project config. A new local file can't leak by accident.
**/.claude/*
!**/.claude/settings.json
!**/.claude/hooks/
!**/.claude/agents/
!**/.claude/commands/
!**/.claude/skills/
CLAUDE.local.md

# Local API cache of calibration tables and file layouts
server/.cache/
